<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.benedict.m321</groupId>
        <artifactId>it3c-m321</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>desktop-client</artifactId>
    <name>desktop-client</name>
    <description>Zweiter Client in JavaFX an derselben Schnittstelle wie die Web-UI</description>

    <properties>
        <!-- JavaFX 21 passt zu Java 21 (beides Langzeitversionen). -->
        <javafx.version>21.0.6</javafx.version>
        <main.class>ch.benedict.m321.desktopclient.Launcher</main.class>
    </properties>

    <dependencies>
        <!-- Die Oberfläche: Fenster, Listen, Knöpfe. Kein Spring im Client. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- JSON lesen und schreiben, Instant im ISO-Format -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- HTTP, WebSocket und der kleine Webserver für die Rückleitung
             kommen aus dem JDK selbst (java.net.http, com.sun.net.httpserver). -->

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Startet den Client: mvn -pl desktop-client javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
