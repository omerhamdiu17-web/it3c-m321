# Beispielwerte für den Unterricht. Die echte .env steht in .gitignore.
RABBITMQ_USER=chat
RABBITMQ_PASSWORD=bitte-lokal-aendern

# Postgres: Superuser sowie die zwei Anwendungsbenutzer aus postgres/init.
POSTGRES_PASSWORD=bitte-lokal-aendern
CHAT_DB_PASSWORD=bitte-lokal-aendern
KEYCLOAK_DB_PASSWORD=bitte-lokal-aendern

# Keycloak: Admin-Konto des Login-Dienstes (Realm "master").
KEYCLOAK_ADMIN_PASSWORD=bitte-lokal-aendern

# Geheimnis des Clients "web-gateway". Muss zum Wert in
# keycloak/realm-chat.json passen; der Realm-Import kann .env nicht lesen.
KEYCLOAK_CLIENT_SECRET=dev-only-gateway-secret
